# Admin girisi (tek sifre)
ADMIN_PASSWORD=degistir-guclu-sifre
# SESSION_SECRET=uzun-rastgele-string
# META_APP_SECRET=  (webhook POST imzasi X-Hub-Signature-256)

# MongoDB (Atlas veya Render Mongo — production)
MONGO_URL=mongodb+srv://USER:PASS@CLUSTER/sosyal_medya
DB_NAME=sosyal_medya

# Render dis URL (ornek: https://sosyal-medya.onrender.com)
NEXT_PUBLIC_BASE_URL=http://localhost:3001
CORS_ORIGINS=*

# Video/medya diski (Render: /var/data — yerel: bos birak, proje kokunu kullanir)
# DATA_DIR=/var/data

GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_STT_MODEL=gemini-3.5-transcribe

BACKGROUND_PROVIDER=removebg
REMOVE_BG_API_KEY=

# Telegram — FB ve YT ayri botlar (Render env)
# TELEGRAM_FB_BOT_TOKEN=
# TELEGRAM_YT_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=

# YouTube Data API (yorum OKUMA). Yoruma yazmak icin Google OAuth gerekir.
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
